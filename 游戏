                    <span class="slot-label">未来</span>
                </div>
            </div>

            <div class="buttons-container">
                <button class="btn btn-draw" id="drawBtn" onclick="drawCard()" disabled>🔮 抽取塔罗牌</button>
                <button class="btn btn-reset" onclick="resetGame()">🔄 重新开始</button>
            </div>

            <div class="result-area" id="resultArea">
                <div class="result-title">📜 占卜结果</div>
                <div class="result-content" id="resultContent"></div>
            </div>
        </div>

        <!-- 牌库 -->
        <div class="deck-section">
            <h2 class="deck-title">🎴 塔罗牌全览（点击查看详情）</h2>
            <div class="deck-grid" id="deckGrid"></div>
        </div>
    </div>

    <!-- 模态框 -->
    <div class="modal" id="modal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <span class="close-btn" onclick="closeModal()">✕</span>
            <div class="modal-card-header">
                <div class="modal-emoji" id="modalEmoji"></div>
                <div class="modal-card-name" id="modalName"></div>
                <div class="modal-card-type" id="modalType"></div>
            </div>
            <div class="modal-section">
                <h3>📖 牌面含义</h3>
                <p id="modalMeaning"></p>
            </div>
            <div class="modal-section">
                <h3>💫 正位解读</h3>
                <p id="modalUpright"></p>
            </div>
            <div class="modal-section">
                <h3>🌙 逆位解读</h3>
                <p id="modalReversed"></p>
            </div>
        </div>
    </div>

