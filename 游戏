        function initDeck() {
            const grid = document.getElementById('deckGrid');
            grid.innerHTML = '';
            tarotCards.forEach((card, index) => {
                const cardEl = document.createElement('div');
                cardEl.className = 'deck-card';
                cardEl.innerHTML = `
                    <div class="emoji">${card.emoji}</div>
                    <div class="name">${card.name}</div>
                `;
                cardEl.onclick = () => showCardDetail(index);
                grid.appendChild(cardEl);
            });
        }

        // 选择卡槽
        function selectSlot(index) {
            if (drawnCards[index]) return; // 已抽牌的槽位不能重选
            
            document.querySelectorAll('.card-slot').forEach((slot, i) => {
                slot.classList.toggle('selected', i === index);
            });
            selectedSlot = index;
            document.getElementById('drawBtn').disabled = false;
        }

        // 抽牌
        function drawCard() {
            if (selectedSlot === null) {
                alert('请先选择一个卡片槽位！');
                return;
            }

            // 获取未抽过的牌
            const availableCards = tarotCards.filter((_, idx) => !selectedCards.has(idx));
            if (availableCards.length === 0) {
                alert('所有牌都已抽完！');
                return;
            }

            const randomCard = availableCards[Math.floor(Math.random() * availableCards.length)];
            const cardIndex = tarotCards.indexOf(randomCard);
            const isReversed = Math.random() < 0.3; // 30%概率逆位
            
            selectedCards.add(cardIndex);
            drawnCards[selectedSlot] = { card: randomCard, isReversed, index: cardIndex };

            // 更新槽位显示
            const slotEl = document.querySelector(`[data-slot="${selectedSlot}"]`);
            slotEl.classList.remove('selected');
            slotEl.classList.add('filled');
            slotEl.innerHTML = `
                <div class="card-display">
                    <div class="card-emoji">${randomCard.emoji}</div>
                    <div class="card-name">${randomCard.name}</div>
                    <div class="card-orientation">${isReversed ? '逆位' : '正位'}</div>
                </div>
            `;

            // 显示结果
            showResult();
            
            // 重置选择
            selectedSlot = null;
            document.getElementById('drawBtn').disabled = true;

            // 检查是否全部抽完
            if (drawnCards.every(c => c !== null)) {
                setTimeout(() => {
                    document.getElementById('resultArea').innerHTML += 
                        '<br><br>🎉 <strong>三牌阵已完成！这是你的完整占卜解读。</strong>';
                }, 500);
            }
        }

        // 显示结果
        function showResult() {
            const resultArea = document.getElementById('resultArea');
            const resultContent = document.getElementById('resultContent');
            
            let html = '';
            const positions = ['过去', '现在', '未来'];
            
            drawnCards.forEach((drawn, i) => {
                if (drawn) {
                    const interpretation = drawn.isReversed ? drawn.card.reversed : drawn.card.upright;
                    html += `
                        <p style="margin-bottom: 15px;">
                            <strong style="color: #ffd700;">【${positions[i]}】${drawn.card.emoji} ${drawn.card.name}（${drawn.isReversed ? '逆位' : '正位'}）</strong><br>
                            ${interpretation}
                        </p>
                    `;
                }
            });
            
            resultContent.innerHTML = html;
            resultArea.classList.add('show');
        }

        // 重置游戏
        function resetGame() {
            selectedSlot = null;
            drawnCards = [null, null, null];
            selectedCards.clear();
            
            document.querySelectorAll('.card-slot').forEach((slot, i) => {
                const placeholders = ['🌙', '⭐', '☀️'];
                const labels = ['过去', '现在', '未来'];
                slot.className = 'card-slot';
                slot.innerHTML = `
                    <span class="slot-placeholder">${placeholders[i]}</span>
                    <span class="slot-label">${labels[i]}</span>
                `;
            });
            
            document.getElementById('drawBtn').disabled = true;
            document.getElementById('resultArea').classList.remove('show');
        }

        // 显示卡片详情
        function showCardDetail(index) {
            const card = tarotCards[index];
            document.getElementById('modalEmoji').textContent = card.emoji;
            document.getElementById('modalName').textContent = card.name;
            document.getElementById('modalType').textContent = card.type;
            document.getElementById('modalMeaning').textContent = card.meaning;
            document.getElementById('modalUpright').textContent = card.upright;
            document.getElementById('modalReversed').textContent = card.reversed;
            document.getElementById('modal').classList.add('show');
        }

        // 关闭模态框
        function closeModal(event) {
            if (!event || event.target.id === 'modal' || event.target.className === 'close-btn') {
                document.getElementById('modal').classList.remove('show');
            }
        }

        // 初始化
        initDeck();
    </script>
</body>
</html>
